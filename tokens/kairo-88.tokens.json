{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "base": {
      "inkNight": { "$type": "color", "$value": "#080B12" },
      "carbonRail": { "$type": "color", "$value": "#111722" },
      "steelLine": { "$type": "color", "$value": "#334155" },
      "paperWarm": { "$type": "color", "$value": "#F6F1E8" },
      "porcelain": { "$type": "color", "$value": "#FFFDF7" },
      "inkPrint": { "$type": "color", "$value": "#151820" },
      "terminalBlack": { "$type": "color", "$value": "#0B0F14" },
      "labPanel": { "$type": "color", "$value": "#121A22" },
      "labPanelAlt": { "$type": "color", "$value": "#16202A" },
      "interfaceMist": { "$type": "color", "$value": "#D7E1EA" },
      "systemMuted": { "$type": "color", "$value": "#8D9AA8" }
    },
    "accent": {
      "neonCyan": { "$type": "color", "$value": "#18D7E8" },
      "signalMagenta": { "$type": "color", "$value": "#F04E98" },
      "vermilion": { "$type": "color", "$value": "#F2553D" },
      "amberLamp": { "$type": "color", "$value": "#F6B73C" },
      "mintGlass": { "$type": "color", "$value": "#68D8A7" },
      "indigoDusk": { "$type": "color", "$value": "#4857B8" },
      "technicalGreen": { "$type": "color", "$value": "#9FB7A5" },
      "blueprint": { "$type": "color", "$value": "#7AA2C7" },
      "systemAmber": { "$type": "color", "$value": "#D6A84F" },
      "alertRed": { "$type": "color", "$value": "#E84A4A" }
    },
    "semantic": {
      "info": { "$type": "color", "$value": "{color.accent.neonCyan}" },
      "success": { "$type": "color", "$value": "{color.accent.mintGlass}" },
      "warning": { "$type": "color", "$value": "{color.accent.amberLamp}" },
      "danger": { "$type": "color", "$value": "{color.accent.vermilion}" },
      "selected": { "$type": "color", "$value": "{color.accent.signalMagenta}" }
    }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0px" },
    "xs": { "$type": "dimension", "$value": "2px" },
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "8px" }
  },
  "font": {
    "family": {
      "ui": { "$type": "fontFamily", "$value": "Noto Sans, Noto Sans JP, Inter, system-ui, sans-serif" },
      "display": { "$type": "fontFamily", "$value": "IBM Plex Sans, Sora, Space Grotesk, system-ui, sans-serif" },
      "mono": { "$type": "fontFamily", "$value": "IBM Plex Mono, Roboto Mono, ui-monospace, monospace" }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": "12px" },
      "sm": { "$type": "dimension", "$value": "14px" },
      "md": { "$type": "dimension", "$value": "16px" },
      "lg": { "$type": "dimension", "$value": "20px" },
      "xl": { "$type": "dimension", "$value": "28px" },
      "2xl": { "$type": "dimension", "$value": "40px" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    }
  },
  "icon": {
    "size": {
      "xs": { "$type": "dimension", "$value": "16px" },
      "sm": { "$type": "dimension", "$value": "20px" },
      "md": { "$type": "dimension", "$value": "24px" },
      "lg": { "$type": "dimension", "$value": "32px" }
    },
    "stroke": {
      "standard": { "$type": "number", "$value": 1.75 },
      "strong": { "$type": "number", "$value": 2 }
    }
  },
  "motion": {
    "duration": {
      "micro": { "$type": "duration", "$value": "90ms" },
      "fast": { "$type": "duration", "$value": "120ms" },
      "base": { "$type": "duration", "$value": "180ms" },
      "slow": { "$type": "duration", "$value": "240ms" },
      "emphasis": { "$type": "duration", "$value": "360ms" },
      "loop": { "$type": "duration", "$value": "1200ms" }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
      "snap": { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1] },
      "scan": { "$type": "cubicBezier", "$value": [0.45, 0, 0.55, 1] }
    }
  }
}
